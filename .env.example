# Copy to .env on the work PC. Do not commit .env.

APP_ENV=dev
LOG_LEVEL=INFO

# Corpus (absolute path on work PC, or relative to project)
NORMATIVKA_DIR=./data/raw
IR_DIR=./data/ir
CACHE_DIR=./data/cache

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=normativka

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Models (paths on work PC)
LLM_GGUF_PATH=
VLM_GGUF_PATH=
VLM_MMPROJ_PATH=
LLAMA_SERVER_BIN=llama-server
MODEL_HOST=127.0.0.1
MODEL_PORT=8080

# Feature flags for modest hardware
ENABLE_VLM=false
ENABLE_GPU_OCR=false
PAGE_CONFIDENCE_THRESHOLD=0.85

# Source analysis / preprocess
TLQ_THRESHOLD=0.65
TLQ_ENABLE_VISUAL_AGREEMENT=true
RENDER_DPI=200
RENDER_DPI_BAD=300
PREPROCESS_ENABLE_BINARIZE=false

# Lexical garbage detection (embedded OCR-like text layer)
LEXICAL_VETO_THRESHOLD=0.75
LEXICAL_MIN_TOKENS=25

# Page extract A/B/C/D
CLASS_B_LEX_MIN=0.62
CLASS_B_DICT_MIN=0.58
AB_ALWAYS_OCR_CHECK=false
AB_ENABLE_VLM_CHECK=true
AB_OCR_AGREE_MIN=0.45
AB_ESCALATE_AGREE=0.50
CD_OCR_FALLBACK=true
CD_FAIL_OCR_CONF=0.55
VLM_TIMEOUT_S=180

# RapidOCR (offline models in OCR_MODEL_DIR — see scripts/prepare_ocr_models.py)
OCR_MODEL_DIR=./data/models/ocr
OCR_MAX_SIDE_LEN=4000
OCR_BAND_TRIGGER_PX=2800
OCR_BAND_HEIGHT=1600

# Formulas / tables / figures
ENABLE_UNIMERNET=false
UNIMERNET_MODEL=Wanderhub/UniMERNet
FORMULA_VLM_RECOVERY=true
TABLE_ENABLE_DOCLING=true
TABLE_ENABLE_PPSTRUCTURE=true
TABLE_ENABLE_IMG2TABLE=true
TABLE_ACCEPT_THRESHOLD=0.45
TABLE_VLM_RECOVERY=true
FIGURE_VLM_CAPTION=true

# Retrieval
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANK_ENABLED=false
